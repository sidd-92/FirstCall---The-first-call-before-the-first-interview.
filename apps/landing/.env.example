# Copy to .env.local for local dev (Vite loads env files from this app's own
# directory, not the monorepo root -- see root .env.example for the backend's vars).

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Agent's email address, used to build the "Copy application email" mailto: link.
VITE_AGENT_EMAIL_ADDRESS=
