# Copy to .env.local for local dev (Vite loads env files from this app's own
# directory, not the monorepo root -- see root .env.example for the backend's vars).

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Auth0 SPA application (Application Type: Single Page Application).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Auth0 API identifier (must match the backend's AUTH0_AUDIENCE) -- without
# this, Auth0 issues an opaque access token instead of a JWT the backend can
# verify as a Bearer token.
VITE_AUTH0_AUDIENCE=

# Must match the backend's PLATFORM_ADMIN_EMAIL -- only used client-side to
# decide whether to show the "Admin" nav link/page at all. Real enforcement
# is server-side (services/backend/src/auth.py's require_admin); this is
# just so a non-admin never sees a link to a page that will 403 anyway.
VITE_PLATFORM_ADMIN_EMAIL=
