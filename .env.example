# Copy this file to .env and fill in values.
# This file is loaded by both services/mcp-server and services/backend when
# run via docker-compose (see docker-compose.yml's `env_file`), and can also
# be used for local (non-docker) `uv run` dev.

# Caspian SDK (used by services/mcp-server/src/caspian_client.py) --
# points at the hosted Caspian gateway, no CASPIAN_BASE_URL override needed.
CASPIAN_API_KEY=

# Discord bot credentials for the Discord channel (see caspian-sdk's
# CommClient.connect_discord, and models.ChannelType.discord).
DISCORD_BOT_TOKEN=

# Anthropic API key for the LLM agent driving screening/conversation logic.
ANTHROPIC_API_KEY=

# Auth0 (used by services/backend/src/auth.py to verify dashboard JWTs)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Database -- shared by mcp-server and backend. This relative path is for
# local (non-docker) dev; docker-compose.yml overrides this to the shared
# `sqlite_data` volume path (sqlite:////data/firstcall.db) for both containers.
DATABASE_URL=sqlite:///./firstcall.db

# Fernet key used to encrypt message content at rest (see
# services/mcp-server/src/storage.py and services/backend/src/models.py's
# Message.content_encrypted). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Backend (FastAPI)
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API from a browser (landing/dashboard
# Vite dev servers by default -- see src/main.py's CORSMiddleware setup).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# MCP server
MCP_SERVER_PORT=8100

# Dashboard / Landing (Vite) -- Vite loads env files from each app's own
# directory (see apps/landing/.env.example and apps/dashboard/.env.example),
# not this root file; listed here for a full inventory of every env var
# referenced across the project.
VITE_API_BASE_URL=http://localhost:8000
VITE_AGENT_EMAIL_ADDRESS=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
